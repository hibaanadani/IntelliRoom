    {
      "parameters": {
        "jsCode": "// n8n Code Node - Find Available 1-Hour Calendar Slots (Business Hours: 10 AM - 6 PM)\n// Input: Google Calendar events and filter dates\n// Output: Array of available 1-hour time slots during business hours\n\n// Get input data - try different n8n access methods\nlet inputData;\ntry {\n  inputData = $input.all();\n} catch (e) {\n  inputData = [$input.item];\n}\n\n// Debug: Check what we actually received\nconsole.log('Raw input data:', JSON.stringify(inputData, null, 2));\n\n// Try to extract filter and events data safely\nlet filterData = null;\nlet eventsData = [];\n\n// Method 1: Try the original structure\ntry {\n  if (inputData && inputData[0] && inputData[0].data) {\n    filterData = inputData[0].data[0];\n    eventsData = inputData[0].data[1] ? inputData[0].data[1].data || [] : [];\n  }\n} catch (e) {\n  console.log('Method 1 failed:', e.message);\n}\n\n// Method 2: Try direct access if method 1 failed\nif (!filterData) {\n  try {\n    // Maybe the structure is flatter\n    if (inputData && inputData[0]) {\n      if (inputData[0].filter_start) {\n        filterData = inputData[0];\n        eventsData = inputData[1] ? inputData[1] : [];\n      } else if (inputData[0].json && inputData[0].json.data) {\n        filterData = inputData[0].json.data[0];\n        eventsData = inputData[0].json.data[1] ? inputData[0].json.data[1].data || [] : [];\n      }\n    }\n  } catch (e) {\n    console.log('Method 2 failed:', e.message);\n  }\n}\n\n// Method 3: Try using $input.first() if available\nif (!filterData) {\n  try {\n    const firstInput = $input.first();\n    if (firstInput && firstInput.data) {\n      filterData = firstInput.data[0];\n      eventsData = firstInput.data[1] ? firstInput.data[1].data || [] : [];\n    }\n  } catch (e) {\n    console.log('Method 3 failed:', e.message);\n  }\n}\n\n// Final validation\nif (!filterData || !filterData.filter_start || !filterData.filter_end) {\n  throw new Error('Could not extract filter_start and filter_end from input. Please check the input data structure.');\n}\n\nconsole.log('Successfully extracted filter data:', filterData);\nconsole.log('Events count:', eventsData.length);\n\nconst filterStart = new Date(filterData.filter_start);\nconst filterEnd = new Date(filterData.filter_end);\n\n// Business hours configuration\nconst BUSINESS_START_HOUR = 10; // 10 AM\nconst BUSINESS_END_HOUR = 18;   // 6 PM\n\n// Function to check if a time slot is within business hours\nfunction isWithinBusinessHours(startTime, endTime) {\n  const startHour = startTime.getHours();\n  const endHour = endTime.getHours();\n  \n  // Check if slot starts at or after 10 AM and ends at or before 6 PM\n  return startHour >= BUSINESS_START_HOUR && endHour <= BUSINESS_END_HOUR;\n}\n\n// Function to convert event times to Date objects\nfunction parseEventTime(eventTime) {\n  return new Date(eventTime);\n}\n\n// Get all existing events with their start and end times\nconst existingEvents = eventsData.map(event => ({\n  start: parseEventTime(event.start.dateTime),\n  end: parseEventTime(event.end.dateTime),\n  id: event.id\n}));\n\n// Sort events by start time\nexistingEvents.sort((a, b) => a.start - b.start);\n\n// Function to check if two time ranges overlap\nfunction isOverlapping(start1, end1, start2, end2) {\n  return start1 < end2 && start2 < end1;\n}\n\n// Function to generate all possible 1-hour slots in the date range during business hours\nfunction generateAvailableSlots(startDate, endDate, existingEvents) {\n  const availableSlots = [];\n  const slotDuration = 60 * 60 * 1000; // 1 hour in milliseconds\n  \n  // Start from the beginning of the filter period\n  let currentDate = new Date(startDate);\n  currentDate.setHours(0, 0, 0, 0); // Start at beginning of day\n  \n  while (currentDate < endDate) {\n    // Generate slots for each day during business hours\n    for (let hour = BUSINESS_START_HOUR; hour < BUSINESS_END_HOUR; hour++) {\n      const currentSlotStart = new Date(currentDate);\n      currentSlotStart.setHours(hour, 0, 0, 0);\n      \n      const currentSlotEnd = new Date(currentSlotStart.getTime() + slotDuration);\n      \n      // Skip if slot is outside the filter range\n      if (currentSlotStart < startDate || currentSlotEnd > endDate) {\n        continue;\n      }\n      \n      // Check if this slot conflicts with any existing events\n      let isAvailable = true;\n      \n      for (const event of existingEvents) {\n        if (isOverlapping(currentSlotStart, currentSlotEnd, event.start, event.end)) {\n          isAvailable = false;\n          break;\n        }\n      }\n      \n      if (isAvailable) {\n        availableSlots.push({\n          start: currentSlotStart.toISOString(),\n          end: currentSlotEnd.toISOString(),\n          startFormatted: currentSlotStart.toLocaleString('en-US', { \n            timeZone: 'Asia/Beirut',\n            year: 'numeric',\n            month: '2-digit',\n            day: '2-digit',\n            hour: '2-digit',\n            minute: '2-digit',\n            hour12: true\n          }),\n          endFormatted: currentSlotEnd.toLocaleString('en-US', { \n            timeZone: 'Asia/Beirut',\n            year: 'numeric',\n            month: '2-digit',\n            day: '2-digit',\n            hour: '2-digit',\n            minute: '2-digit',\n            hour12: true\n          }),\n          duration: \"1 hour\",\n          dayOfWeek: currentSlotStart.toLocaleDateString('en-US', { \n            weekday: 'long',\n            timeZone: 'Asia/Beirut'\n          }),\n          date: currentSlotStart.toLocaleDateString('en-US', {\n            timeZone: 'Asia/Beirut'\n          }),\n          businessHour: `${hour}:00 - ${hour + 1}:00`\n        });\n      }\n    }\n    \n    // Move to next day\n    currentDate.setDate(currentDate.getDate() + 1);\n  }\n  \n  return availableSlots;\n}\n\n// Generate available slots\nconst availableSlots = generateAvailableSlots(filterStart, filterEnd, existingEvents);\n\n// Prepare output data\nconst output = {\n  summary: {\n    totalAvailableSlots: availableSlots.length,\n    businessHours: `${BUSINESS_START_HOUR}:00 - ${BUSINESS_END_HOUR}:00`,\n    filterPeriod: {\n      start: filterStart.toISOString(),\n      end: filterEnd.toISOString(),\n      startFormatted: filterStart.toLocaleString('en-US', { timeZone: 'Asia/Beirut' }),\n      endFormatted: filterEnd.toLocaleString('en-US', { timeZone: 'Asia/Beirut' })\n    },\n    existingEventsCount: existingEvents.length\n  },\n  availableSlots: availableSlots,\n  existingEvents: existingEvents.map(event => ({\n    start: event.start.toISOString(),\n    end: event.end.toISOString(),\n    startFormatted: event.start.toLocaleString('en-US', { timeZone: 'Asia/Beirut' }),\n    endFormatted: event.end.toLocaleString('en-US', { timeZone: 'Asia/Beirut' }),\n    id: event.id\n  }))\n};\n\n// Return the results\nreturn [output];"
      },
