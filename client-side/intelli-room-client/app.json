{
  "expo": {
    "name": "IntelliRoom",
    "slug": "IntelliRoom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/IntelliRoom.png",
    "scheme": "intelliroomclient",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/IntelliRoom.png",
        "backgroundColor": "#FEF7E5"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "splash": {
      "image": "./assets/images/IntelliRoom.png",
      "backgroundColor": "#FEF7E5",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}